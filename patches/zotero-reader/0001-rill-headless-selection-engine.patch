diff --git a/src/index.rill.js b/src/index.rill.js
new file mode 100644
index 0000000..bfa1e2f
--- /dev/null
+++ b/src/index.rill.js
@@ -0,0 +1,79 @@
+import View from './common/view';
+
+// UI-free bridge used by Rill. The upstream View renders PDF pages and text
+// geometry only; Rill owns menus, notes, annotation state and persistence.
+window.createRillPdfEngine = (options) => {
+	let revision = -1;
+	let listeners = new Set();
+	let emit = (type, payload = {}) => {
+		for (let listener of listeners) {
+			listener({ type, ...payload });
+		}
+	};
+	let onKeyDown = (event) => {
+		if (!(event.metaKey || event.ctrlKey) || event.altKey) return;
+		let key = event.key.toLowerCase();
+		if (key === 'c') {
+			event.preventDefault();
+			emit('shortcut', { command: 'copy-selection' });
+		}
+		else if (key === 'f') {
+			event.preventDefault();
+			emit('shortcut', { command: 'focus-search' });
+		}
+	};
+	document.addEventListener('keydown', onKeyDown, true);
+	let view = new View({
+		...options,
+		platform: 'web',
+		container: document.getElementById('view'),
+		onInitialized: () => emit('initialized'),
+		onSaveAnnotations: () => undefined,
+		onCreateAnnotation: (annotation) => emit('annotation-draft', { annotation }),
+		onSetOutline: (outline) => emit('outline-changed', { outline }),
+		onRequestPassword: () => emit('password-required'),
+		onInitThumbnails: () => undefined,
+		onRenderThumbnail: () => undefined,
+		onSetThumbnails: () => undefined,
+		onSetPageLabels: (pageLabels) => emit('page-labels-changed', { pageLabels }),
+		onDeleteAnnotations: () => undefined,
+		onSelectAnnotations: (ids) => emit('annotations-selected', { ids }),
+		onSetSelectionPopup: (params) => emit(params ? 'selection-finalized' : 'selection-cleared', params || {}),
+		onSetAnnotationPopup: (params) => emit(params ? 'annotation-activated' : 'annotation-deactivated', params || {}),
+		onOpenLink: (url) => emit('link-opened', { url }),
+		onFindResult: (result) => emit('search-changed', { result }),
+		onChangeViewState: (state) => emit('view-state-changed', { state }),
+		onChangeViewStats: (stats) => emit('view-stats-changed', { stats }),
+		onBackdropTap: () => emit('backdrop-tapped'),
+		onContextMenu: params => emit('context-menu-requested', params)
+	});
+
+	return Object.freeze({
+		navigate: target => view.navigate(target),
+		zoomIn: () => view.zoomIn(),
+		zoomOut: () => view.zoomOut(),
+		zoomPageWidth: () => view.zoomReset(),
+		setSpread: enabled => view.setSpreadMode(enabled ? 1 : 0),
+		setTool: tool => view.setTool(tool === 'area-capture' ? { type: 'image' } : { type: 'pointer' }),
+		setAnnotations: (snapshot, nextRevision) => {
+			if (nextRevision < revision) return false;
+			revision = nextRevision;
+			view.setAnnotationSnapshot(snapshot);
+			return true;
+		},
+		search: query => view.find(query ? { query, highlightAll: true, caseSensitive: false, entireWord: false } : null),
+		findNext: () => view.findNext(),
+		findPrevious: () => view.findPrevious(),
+		clearSelection: () => view.clearSelection(),
+		subscribe: listener => {
+			listeners.add(listener);
+			return () => listeners.delete(listener);
+		},
+		destroy: () => {
+			document.removeEventListener('keydown', onKeyDown, true);
+			listeners.clear();
+			view.destroy();
+			view = null;
+		}
+	});
+};
